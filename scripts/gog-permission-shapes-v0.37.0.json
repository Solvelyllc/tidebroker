      "allowedKeys": ["document.documentId", "document.revisionId", "file.id", "file.mimeType"],
      "fieldTypes": {
        "document.documentId": "string",
        "document.revisionId": "string",
        "file.id": "string",
        "file.mimeType": "string"
      }
    },
    "sheets": {
      "rootType": "object",
      "requiredKeys": ["spreadsheetId"],
      "allowedKeys": ["spreadsheetId"],
      "fieldTypes": { "spreadsheetId": "string" }
    }
  }
